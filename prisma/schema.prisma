// Cloud Security Posture & Compliance Monitoring (CSPM) Platform
// Read-only assessment of authorized cloud configuration data against
// documented security checks mapped to CIS Benchmarks and ISO 27001.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/// A connected cloud account. The platform operates in read-only mode against
/// snapshots of configuration data collected from authorized APIs.
model CloudAccount {
  id           String   @id @default(cuid())
  provider     String // e.g. "aws", "gcp", "azure"
  accountId    String // cloud-native account/tenant identifier
  displayName  String
  region       String?
  scanMode     String   @default("read-only") // always read-only in this prototype
  lastSyncedAt DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  resources    Resource[]
  assessments  Assessment[]
  snapshots   ComplianceSnapshot[]

  @@unique([provider, accountId])
}

/// A cloud resource discovered during a read-only configuration scan.
/// `config` stores the raw configuration JSON captured at scan time.
model Resource {
  id          String   @id @default(cuid())
  accountId   String
  service     String // iam | storage | networking | encryption | logging
  resourceType String // e.g. "aws_iam_user", "aws_s3_bucket", "aws_security_group"
  name        String
  region      String?
  arn         String?
  config      String // JSON string of the captured configuration
  /// Business criticality assigned by the asset owner. Drives the risk score
  /// so a low-severity finding on a critical asset can outrank a high-severity
  /// finding on a non-critical one.
  criticality String   @default("medium") // low | medium | high | critical
  /// Whether the resource is internet-reachable. Used by attack-path analysis.
  internetFacing Boolean @default(false)
  lastSeenAt  DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  account     CloudAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  findings    Finding[]

  @@index([accountId, service])
}

/// A documented security check. Defines what is evaluated, why it matters,
/// its default severity, and mappings to CIS / ISO 27001 controls.
model SecurityCheck {
  id                String   @id @default(cuid())
  checkId           String   @unique // stable identifier e.g. "IAM-001"
  service           String   // iam | storage | networking | encryption | logging
  title             String
  description       String
  rationale        String
  severity          String   // critical | high | medium | low
  cisBenchmark      String?  // e.g. "CIS AWS Foundations 3.1"
  iso27001Controls  String?  // e.g. "A.5.15, A.8.2"
  remediationGuidance String
  evaluationLogic   String   // textual description of how the check is evaluated
  remediationEffort String  @default("medium") // low | medium | high
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  findings          Finding[]
}

/// An assessment run. Each run re-evaluates the latest resource snapshot
/// against the security checks library.
model Assessment {
  id           String   @id @default(cuid())
  accountId    String
  status       String   @default("completed") // running | completed | failed
  trigger      String   @default("manual") // manual | scheduled
  totalChecks  Int      @default(0)
  passed       Int      @default(0)
  failed       Int      @default(0)
  errors       Int      @default(0)
  durationMs   Int      @default(0)
  startedAt    DateTime @default(now())
  completedAt  DateTime?
  account      CloudAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  findings     Finding[]

  @@index([accountId, startedAt])
}

/// A single evaluation result for one resource against one check.
model Finding {
  id                String   @id @default(cuid())
  assessmentId      String
  checkId           String
  resourceId        String
  service           String
  severity          String // critical | high | medium | low
  status            String   @default("open") // open | in_progress | resolved | suppressed
  result            String   // pass | fail | error
  evidence          String   // JSON string of evidence captured from the resource config
  /// Business-aware risk score (0..100). Combines control severity with the
  /// affected asset's criticality and exposure so remediation can be prioritized
  /// by real-world impact rather than raw severity alone.
  riskScore         Int      @default(0)
  firstDetectedAt   DateTime @default(now())
  lastDetectedAt    DateTime @default(now())
  resolvedAt        DateTime?
  assignee          String?
  notes             String?

  assessment        Assessment    @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  check             SecurityCheck @relation(fields: [checkId], references: [id], onDelete: Cascade)
  resource          Resource      @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  remediations      Remediation[]

  @@index([status, severity])
  @@index([service, status])
  @@index([riskScore])
}

/// Remediation activity log for a finding. Supports tracking progress over
/// time without modifying the original evidence.
model Remediation {
  id          String   @id @default(cuid())
  findingId   String
  action      String   // status_change | note | assigned
  fromStatus  String?
  toStatus    String?
  note        String?
  author      String   @default("analyst")
  createdAt   DateTime @default(now())

  finding     Finding  @relation(fields: [findingId], references: [id], onDelete: Cascade)

  @@index([findingId, createdAt])
}

/// A point-in-time compliance score snapshot for trend tracking.
model ComplianceSnapshot {
  id           String   @id @default(cuid())
  accountId    String
  takenAt      DateTime @default(now())
  totalChecks  Int      @default(0)
  passed       Int      @default(0)
  failed       Int      @default(0)
  critical     Int      @default(0)
  high         Int      @default(0)
  medium       Int      @default(0)
  low          Int      @default(0)
  openCount    Int      @default(0)
  resolvedCount Int     @default(0)
  score        Int      @default(0) // 0..100

  account      CloudAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId, takenAt])
}

/// Append-only audit log of every state-changing action in the platform.
/// Provides a tamper-evident trail for who changed what, when, and why —
/// essential for a security/compliance tool that itself must be auditable.
model AuditLog {
  id          String   @id @default(cuid())
  actor       String   // user/service principal that performed the action
  action      String   // finding.status_change | assessment.run | report.download | ...
  targetType  String   // finding | assessment | account | ...
  targetId    String?
  detail      String   // human-readable summary
  metadata    String?  // JSON of structured before/after context
  ipAddress   String?
  createdAt   DateTime @default(now())

  @@index([action, createdAt])
  @@index([targetType, targetId])
}
